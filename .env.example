# ---- Server (never committed; copy to .env) ----
# Gemini API key (server only; the browser only ever sees single-use ephemeral tokens)
GEMINI_API_KEY=
# Live model id
GEMINI_LIVE_MODEL=gemini-3.8-live
# Prebuilt voice name for the agent (optional)
GEMINI_VOICE=
# MongoDB Atlas connection string. If empty, the API uses an in-memory store (dev only).
MONGODB_URI=
MONGODB_DB=wayfinder
# Contact shown to Nominatim in the User-Agent (their usage policy asks for one)
NOMINATIM_CONTACT=
# API port inside the container / on localhost
PORT=8787

# ---- Caddy ----
# Domain Caddy serves and fetches a certificate for (use "localhost" for a local test)
DOMAIN=localhost

# ---- deploy.sh ----
DEPLOY_HOST=
DEPLOY_USER=root
DEPLOY_PATH=/opt/wayfinder

# ---- Frontend build-time (optional) ----
# VITE_OSRM_BASE=https://routing.openstreetmap.de/routed-foot
