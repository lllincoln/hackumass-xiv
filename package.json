{
  "name": "wayfinder",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "server"
  ],
  "scripts": {
    "dev": "vite --host",
    "dev:api": "tsx watch --env-file-if-exists=.env server/index.ts",
    "build": "vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run",
    "pack": "tsx scripts/build-campus-pack.ts",
    "terrain": "tsx scripts/build-terrain.ts",
    "seed": "tsx --env-file-if-exists=.env scripts/seed-atlas.ts"
  },
  "dependencies": {
    "@google/genai": "^1.20.0",
    "@react-three/drei": "^10.0.0",
    "@react-three/fiber": "^9.1.0",
    "maplibre-gl": "^5.5.0",
    "osrm-text-instructions": "^0.15.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.176.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.176.0",
    "@vitejs/plugin-basic-ssl": "^2.0.0",
    "@vitejs/plugin-react": "^4.5.0",
    "mongodb": "^6.22.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "vitest": "^3.1.0"
  }
}
